# Copy to .env before starting, or let npm start create it on first run.
# Never commit .env. Restart after changing it. Empty API_KEY enables demo mode.
AI_PROVIDER=deepseek
API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_MAX_TOKENS=16000
AI_TIMEOUT_MS=180000

# OpenAI-compatible example (base includes /v1, not /chat/completions):
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
# API_KEY=your-key

# Anthropic Messages example (base includes /v1, not /messages):
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=claude-sonnet-4-5
# API_KEY=your-key

HOST=127.0.0.1
PORT=3020
# Set to an absolute folder path to store projects elsewhere.
# DATA_DIR=
